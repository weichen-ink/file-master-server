# Dependencies
node_modules/

# Runtime data & backups
data/*
!data/.gitkeep
backups/*

# Storage binaries & caches
storage/raw/*
!storage/raw/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/trash/
storage/tmp/

# Configuration (keep example committed, ignore local secrets)
config.yaml
!config.example.yaml

# System & OS files
.DS_Store
Thumbs.db
*.log
